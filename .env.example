SIGNAL_ENVIRONMENT=local
SIGNAL_LOG_LEVEL=INFO
SIGNAL_DATABASE_URL=postgresql+psycopg://signal:signal@localhost:5432/signal_observatory
SIGNAL_DATABASE_CONNECT_ATTEMPTS=10
SIGNAL_DATABASE_CONNECT_DELAY_SECONDS=2
SIGNAL_RAW_DATA_PATH=data/raw
ARXIV_API_BASE_URL=https://export.arxiv.org/api/query
ARXIV_MIN_REQUEST_INTERVAL_SECONDS=3.0
ARXIV_REQUEST_TIMEOUT_SECONDS=30
ARXIV_PAGE_SIZE=100
ARXIV_MAX_REQUESTS_PER_RUN=250
ARXIV_MAX_RESULTS_PER_TOPIC=1000
ARXIV_INCREMENTAL_OVERLAP_HOURS=48
ARXIV_SCHEDULE=0 2 * * *
VITE_API_BASE_URL=/api
