SIGNAL_ENVIRONMENT=local
SIGNAL_LOG_LEVEL=INFO
SIGNAL_DATABASE_URL=postgresql+psycopg://signal:signal@localhost:5432/signal_observatory
SIGNAL_DATABASE_CONNECT_ATTEMPTS=10
SIGNAL_DATABASE_CONNECT_DELAY_SECONDS=2
SIGNAL_RAW_DATA_PATH=data/raw
SIGNAL_BACKUP_PATH=data/backups
ARXIV_API_BASE_URL=https://export.arxiv.org/api/query
ARXIV_MIN_REQUEST_INTERVAL_SECONDS=3.0
ARXIV_REQUEST_TIMEOUT_SECONDS=30
ARXIV_PAGE_SIZE=100
ARXIV_MAX_REQUESTS_PER_RUN=250
ARXIV_MAX_RESULTS_PER_TOPIC=1000
ARXIV_INCREMENTAL_OVERLAP_HOURS=48
ARXIV_SCHEDULE=0 2 * * *
GITHUB_TOKEN=
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_API_VERSION=2022-11-28
GITHUB_REQUIRE_AUTH=true
GITHUB_ALLOW_ANONYMOUS_SMOKE=false
GITHUB_REQUEST_TIMEOUT_SECONDS=30
GITHUB_REQUEST_CONCURRENCY=1
GITHUB_DISCOVERY_PAGE_SIZE=20
GITHUB_DISCOVERY_MAX_RESULTS_PER_MAPPING=20
GITHUB_MAX_REQUESTS_PER_RUN=100
GITHUB_MIN_CORE_REMAINING=100
GITHUB_MIN_SEARCH_REMAINING=2
GITHUB_SNAPSHOT_SCHEDULE=30 2 * * *
GITHUB_DISCOVERY_SCHEDULE=0 3 * * 0
GITHUB_CONDITIONAL_REQUESTS_ENABLED=true
VITE_API_BASE_URL=/api
